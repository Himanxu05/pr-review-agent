# LLM (groq, openai or anthropic)
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# For the CLI: a personal access token is enough
GITHUB_TOKEN=

# For the webhook server (GitHub App)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=./github-app.pem
GITHUB_WEBHOOK_SECRET=

MAX_FILES=15
MAX_COMMENTS=12
MIN_CONFIDENCE=0.6
MAX_TOOL_STEPS=6
MAX_CONCURRENCY=3
MAX_RETRIES=10

# Optional tracing
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
